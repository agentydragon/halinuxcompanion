[Unit]
Description=Home Assistant Linux Companion
After=network.target bluetooth.target

[Service]
Type=simple
ExecStart=/usr/bin/python -m halinuxcompanion run
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=halinuxcompanion

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/halinuxcompanion

[Install]
WantedBy=default.target
